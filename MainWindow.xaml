                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#F59E0B" Width="14" Height="14" CornerRadius="7" Margin="0,0,8,0" />
                                                        <TextBlock Text="Solar Amber (#F59E0B)" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: TYPOGRAPHY & FONT SCALING -->
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔤 " FontSize="12" />
                                        <TextBlock Text="TIPOGRAFI &amp; SKALA FONT (FONT SELECTOR)"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Atur jenis font antarmuka dan ukuran dasar teks aplikasi agar proporsional di monitor resolusi tinggi maupun stretched."
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Font Family Selector -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Font Family Aplikasi:"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,6" />
                                        <ComboBox Style="{DynamicResource ModernComboBox}"
                                                  ItemsSource="{Binding AvailableFonts}"
                                                  SelectedItem="{Binding SelectedFontFamily}"
                                                  MinHeight="36">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontWeight="Medium" FontSize="12" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Base Font Size Slider -->
                                    <StackPanel Grid.Column="2">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Base Font Size:"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding BaseFontSize, StringFormat='{}{0:F1} pt'}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource ValoRedBrush}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider Style="{DynamicResource ModernSlider}"
                                                Minimum="11.0"
                                                Maximum="15.0"
                                                SmallChange="0.5"
                                                LargeChange="1.0"
                                                Value="{Binding BaseFontSize, UpdateSourceTrigger=PropertyChanged}" />
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="11.0 pt (Kompak)" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="12.5 pt (Default)" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="15.0 pt (Besar)" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Live Preview Card -->
                                <Border Background="{DynamicResource BgDarkBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="LIVE PREVIEW TAMPILAN:"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource ValoRedBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="The quick brown fox jumps over the lazy dog. Resolusi 1280×960 Stretched @ 240Hz dengan kompensasi Yaw 1:1."
                                                   FontSize="{DynamicResource AppBaseFontSize}"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARD 4: PREFERENCES & RESET -->
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="PENYIMPANAN OTOMATIS &amp; RESET PENGATURAN"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,2" />
                                    <TextBlock Text="Preferensi tema, aksen, dan font disimpan secara permanen di AppSettings (config.json) dan dipulihkan saat startup."
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{DynamicResource SecondaryButton}"
                                        Command="{Binding ResetThemeSettingsCommand}"
                                        Height="32"
                                        Padding="14,0"
                                        ToolTip="Kembalikan semua preferensi tema dan font ke pengaturan default">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↺ " FontSize="11" />
                                        <TextBlock Text="Reset ke Default" FontWeight="SemiBold" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ################################################# -->
                    <!-- TAB 4: ABOUT RRES                                 -->
                    <!-- ################################################# -->
                    <StackPanel Visibility="{Binding IsAboutTab, Converter={StaticResource BoolToVisConverter}}">
                        <!-- CARD 1: Informasi Aplikasi -->
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <Border Background="{DynamicResource ValoRedBrush}" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                        <TextBlock Text="R" FontWeight="Black" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="RRes — Valorant Resolution Switcher" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Versi 1.0.0 (Windows x64 Standalone .NET 10)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="RRes adalah utilitas display kompetitif yang dirancang khusus untuk pemain Valorant yang ingin bermain di mode stretched (4:3 / 5:4) dengan refresh rate monitor maksimal, auto-revert saat game selesai, kompensasi eDPI 1:1, dan optimasi input lag."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <Grid>
                                    <TextBlock Text="Created by: RRes Team" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <Button Style="{DynamicResource SecondaryButton}"
                                            Command="{Binding OpenProjectUrlCommand}"
                                            HorizontalAlignment="Right"
                                            Height="24"
                                            Padding="10,0"
                                            Content="GitHub Repository"
                                            FontSize="10" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: GitHub Update Checker -->
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="PEMBARUAN APLIKASI (GITHUB RELEASES)"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <Border Background="{DynamicResource AccentSubtleBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="Update Ready"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource ValoRedBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UpdateStatusMessage}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding UpdateStatusColor}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource PrimaryButton}"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            Height="32"
                                            Padding="14,0"
                                            Margin="0,0,6,0"
                                            ToolTip="Periksa versi rilis terbaru dari repositori GitHub">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔄 " FontSize="10" />
                                            <TextBlock Text="Periksa Pembaruan" FontSize="10.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{DynamicResource OutlineButton}"
                                            Command="{Binding OpenLatestReleaseUrlCommand}"
                                            Height="32"
                                            Padding="12,0"
                                            Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisConverter}}"
                                            ToolTip="Buka halaman rilis GitHub untuk mengunduh versi terbaru">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⬇ " FontSize="10" Foreground="{DynamicResource ValoRedBrush}" />
                                            <TextBlock Text="Unduh Rilis" FontSize="10.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- CARD 3: Ringkasan Fitur Kompetitif -->
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="RINGKASAN TEKNOLOGI &amp; FITUR"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="• Windows Display API (user32.dll): Resolusi desktop instan, multi-monitor selector &amp; pengunci frekuensi Hz" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="• Exclusive Fullscreen Engine: Force True Fullscreen (FullscreenMode=0) untuk mengeliminasi bug Windowed Fullscreen" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="• Custom Resolution Engine: Input bebas lebar &amp; tinggi (Width x Height) jika tidak tersedia di preset" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="• Process Watcher: Auto-revert resolusi ke Native saat game exit &amp; High CPU Priority" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="• Mouse Precision: Disable Windows pointer acceleration (1:1 Raw Input) &amp; eDPI yaw compensator" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="• Network &amp; Anti-Stutter: Ping latency pods checker &amp; GameDVR registry bypass" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                <TextBlock Text="• Riot Config Engine: Interactive profile selector, direct folder explorer &amp; backup .bak otomatis" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Row 2: Status Bar Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Dot Indicator -->
                    <Ellipse Grid.Column="0"
                             Width="7"
                             Height="7"
                             Fill="{Binding StatusType, Converter={StaticResource StatusTypeToBrushConverter}}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />

                    <!-- Status Message -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Muat Ulang Profil Button -->
                    <Button Grid.Column="2"
                            Style="{DynamicResource SecondaryButton}"
                            Command="{Binding RefreshProfilesCommand}"
                            Height="22"
                            Padding="8,0"
                            FontSize="9.5"
                            Content="Muat Ulang" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Border>
</Window>
