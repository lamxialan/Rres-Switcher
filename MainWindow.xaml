<Window x:Class="RRes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:RRes.ViewModels"
        mc:Ignorable="d"
        Title="RRes - Valorant Resolution Switcher"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="920"
        Height="660"
        MinWidth="840"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppBaseFontSize}">

    <!-- Custom Window Chrome for Modern Dragging, Resizing, and Aero Snapping -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Custom Title Bar Window Control Button Styles -->
        <Style x:Key="TitleBarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource TitleBarBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style Tab 0: Display & Res -->
        <Style x:Key="NavTab0Style" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDisplayTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ValoRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style Tab 1: Mouse & Aim -->
        <Style x:Key="NavTab1Style" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ValoRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style Tab 2: Network & Tweaks -->
        <Style x:Key="NavTab2Style" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNetworkTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ValoRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style Tab 3: Settings -->
        <Style x:Key="NavTab3Style" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ValoRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style Tab 4: About -->
        <Style x:Key="NavTab4Style" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAboutTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ValoRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ratio Segment Filter Styles -->
        <Style x:Key="RatioChipSemuaStyle" TargetType="Button" BasedOn="{StaticResource RatioFilterChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRatioSemua}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ValoRedBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ValoRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RatioChip43Style" TargetType="Button" BasedOn="{StaticResource RatioFilterChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRatio43}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ValoRedBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ValoRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RatioChip169Style" TargetType="Button" BasedOn="{StaticResource RatioFilterChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRatio169}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ValoRedBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ValoRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RatioChip1610Style" TargetType="Button" BasedOn="{StaticResource RatioFilterChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRatio1610}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ValoRedBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ValoRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RatioChip54Style" TargetType="Button" BasedOn="{StaticResource RatioFilterChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRatio54}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ValoRedBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ValoRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Resolution Preset Pill Button Style -->
        <Style x:Key="ResolutionPillStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource ValoRedHoverBrush}" />
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ValoRedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Theme Mode Card Styles -->
        <Style x:Key="ThemeDarkCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="12,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ValoRedHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsThemeDark}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ValoRedBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemeOledCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="12,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ValoRedHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsThemeOled}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ValoRedBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemeMidnightCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="12,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ValoRedHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsThemeMidnight}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ValoRedBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemeLightCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="12,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ValoRedHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsThemeLight}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ValoRedBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Outer Root Border to ensure subtle modern border (#2E3340) in windowed mode -->
    <Border x:Name="RootWindowBorder"
            BorderBrush="{DynamicResource BorderDarkBrush}"
            BorderThickness="1"
            Background="{DynamicResource BgDarkBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Custom Dark Title Bar (Height: 34) -->
                <RowDefinition Height="34" />
                <!-- Row 1: Main Application Body (Sidebar + Content Area) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================================================== -->
            <!-- 0. TOP CUSTOM DARK TITLE BAR (#18191E)                   -->
            <!-- ======================================================== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Sisi Kiri: Logo Lego & Judul Aplikasi -->
                        <ColumnDefinition Width="*" />
                        <!-- Sisi Kanan: Tombol Window Chrome (Min, Max, Close) -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sisi Kiri: Logo R Runcing Splash + Judul Jendela -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <!-- Logo 'R' Runcing dengan Outer Glow Merah (#FF4655) -->
                        <Image Source="pack://application:,,,/Assets/splash_logo.png"
                               Width="16"
                               Height="16"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0">
                            <Image.Effect>
                                <DropShadowEffect Color="#FF4655"
                                                  BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Opacity="0.85" />
                            </Image.Effect>
                        </Image>

                        <!-- Window Title Text -->
                        <TextBlock Text="RRes - Valorant Resolution Switcher"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Sisi Kanan: Minimalist Window Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <!-- Minimize Button -->
                        <Button Style="{StaticResource TitleBarBtnStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <TextBlock Text="—" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button Style="{StaticResource TitleBarBtnStyle}"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize / Restore">
                            <TextBlock x:Name="MaximizeIconText" Text="▢" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource TitleBarCloseBtnStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Tutup RRes">
                            <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- 1. MAIN APPLICATION BODY (SIDEBAR & CONTENT)             -->
            <!-- ======================================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- 0: Left Navigation Sidebar -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 1: Right Main Content Area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- 1. LEFT SIDEBAR NAVIGATION (DRAWER / HAMBURGER MENU)     -->
        <!-- ======================================================== -->
        <Border Grid.Column="0"
                Width="{Binding SidebarWidth}"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Top Brand & Hamburger Toggle -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Nav Menu Items -->
                    <RowDefinition Height="*" />
                    <!-- Row 2: Fixed Bottom Actions -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Sidebar Header with Hamburger Button -->
                <Border Grid.Row="0" Padding="12,14" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Hamburger Toggle Button -->
                        <Button Grid.Column="0"
                                Style="{StaticResource HamburgerButton}"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="Toggle Sidebar Menu">
                            <TextBlock Text="☰" FontSize="16" FontWeight="Bold" />
                        </Button>

                        <!-- Brand Header (Expanded only) -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}">
                            <!-- Logo 'R' Runcing dengan Outer Glow Merah (#FF4655) -->
                            <Image Source="pack://application:,,,/Assets/splash_logo.png"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0">
                                <Image.Effect>
                                    <DropShadowEffect Color="#FF4655"
                                                      BlurRadius="12"
                                                      ShadowDepth="0"
                                                      Opacity="0.9" />
                                </Image.Effect>
                            </Image>
                            <TextBlock Text="RRES"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: Nav Menu Items -->
                <StackPanel Grid.Row="1" Margin="8,12">
                    <!-- Nav 0: Display & Res -->
                    <Button Style="{StaticResource NavTab0Style}"
                            Command="{Binding SelectNavTabCommand}"
                            CommandParameter="0"
                            ToolTip="Display, Resolution &amp; Config">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🖥" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Display &amp; Res"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                        </Grid>
                    </Button>

                    <!-- Nav 1: Mouse & Aim -->
                    <Button Style="{StaticResource NavTab1Style}"
                            Command="{Binding SelectNavTabCommand}"
                            CommandParameter="1"
                            ToolTip="eDPI &amp; Aim Precision">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🎯" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Mouse &amp; Aim"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                        </Grid>
                    </Button>

                    <!-- Nav 2: Network & Tweaks -->
                    <Button Style="{StaticResource NavTab2Style}"
                            Command="{Binding SelectNavTabCommand}"
                            CommandParameter="2"
                            ToolTip="Latency, Anti-Stutter &amp; Tweaks">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Network &amp; Tweaks"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                        </Grid>
                    </Button>

                    <!-- Nav 3: Settings (NEW) -->
                    <Button Style="{StaticResource NavTab3Style}"
                            Command="{Binding SelectNavTabCommand}"
                            CommandParameter="3"
                            ToolTip="Pengaturan Tema &amp; Font">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚙" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Settings"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                        </Grid>
                    </Button>

                    <!-- Nav 4: About -->
                    <Button Style="{StaticResource NavTab4Style}"
                            Command="{Binding SelectNavTabCommand}"
                            CommandParameter="4"
                            ToolTip="Tentang RRes &amp; Status">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ℹ" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="About RRes"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Row 2: Fixed Bottom Action Area in Sidebar -->
                <Border Grid.Row="2"
                        Padding="8,10"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- Expanded Buttons -->
                        <StackPanel Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisConverter}}">
                            <!-- Hero Primary Action Button: APPLY & LAUNCH -->
                            <Button Style="{DynamicResource PrimaryButton}"
                                    Command="{Binding ApplyAndLaunchCommand}"
                                    Height="38"
                                    Margin="0,0,0,6"
                                    ToolTip="Terapkan resolusi &amp; buka client game Valorant">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="APPLY &amp; LAUNCH" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Secondary Ghost Actions: Minimal, Flat, Elegant -->
                            <Button Style="{DynamicResource GhostButton}"
                                    Command="{Binding ApplyResolutionCommand}"
                                    Height="26"
                                    Margin="0,1"
                                    ToolTip="Terapkan resolusi &amp; grafik tanpa meluncurkan game">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💾" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Apply Only" FontSize="10.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource GhostButton}"
                                    Command="{Binding QuickLaunchCommand}"
                                    Height="26"
                                    Margin="0,1"
                                    ToolTip="Luncurkan VALORANT langsung tanpa perubahan resolusi">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Quick Launch" FontSize="10.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource GhostButton}"
                                    Command="{Binding RevertToNativeCommand}"
                                    Height="26"
                                    Margin="0,1"
                                    ToolTip="Kembalikan resolusi Windows dan config ke Native">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="↺" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Revert Native" FontSize="10.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Collapsed Compact Icon Buttons -->
                        <StackPanel Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Button Style="{DynamicResource PrimaryButton}"
                                    Command="{Binding ApplyAndLaunchCommand}"
                                    Height="34"
                                    Padding="0"
                                    ToolTip="APPLY &amp; LAUNCH VALORANT">
                                <TextBlock Text="▶" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{DynamicResource GhostButton}"
                                    Command="{Binding ApplyResolutionCommand}"
                                    Height="26"
                                    Padding="0"
                                    Margin="0,3,0,0"
                                    ToolTip="Apply Only (Tanpa Launch)">
                                <TextBlock Text="💾" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{DynamicResource GhostButton}"
                                    Command="{Binding QuickLaunchCommand}"
                                    Height="26"
                                    Padding="0"
                                    Margin="0,2,0,0"
                                    ToolTip="Quick Launch (Tanpa Apply)">
                                <TextBlock Text="⚡" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{DynamicResource GhostButton}"
                                    Command="{Binding RevertToNativeCommand}"
                                    Height="26"
                                    Padding="0"
                                    Margin="0,2,0,0"
                                    ToolTip="Revert to Native">
                                <TextBlock Text="↺" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. RIGHT MAIN CONTENT AREA                               -->
        <!-- ======================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header & Status Badges -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Dynamic Content Views (ScrollViewer) -->
                <RowDefinition Height="*" />
                <!-- Row 2: Status Bar Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Subtitle for current view -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CurrentNavTitle}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding CurrentNavSubtitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Compact Right Header Badges (Modern Capsule Badges) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Riot Ping Capsule Badge -->
                        <Border Background="{DynamicResource BgDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="10,4"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding ServerPingColor}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ServerPingText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0" />
                                <Button Style="{DynamicResource MiniPresetButton}"
                                        Command="{Binding RefreshPingCommand}"
                                        Width="18"
                                        Height="18"
                                        Padding="0"
                                        ToolTip="Refresh Ping Server">
                                    <TextBlock Text="⟳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Active Desktop Resolution Capsule Badge -->
                        <Border Background="{DynamicResource BgDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="10,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="DESKTOP"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding CurrentDesktopResolution}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ValoRedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Dynamic Content Area (Tab Switcher with ScrollViewer) -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,14">
                <StackPanel>

                    <!-- ################################################# -->
                    <!-- TAB 0: DISPLAY & RES (2-COLUMN BALANCED GRID)     -->
                    <!-- ################################################# -->
                    <Grid Visibility="{Binding IsDisplayTab, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <!-- Kolom Kiri: Target Resolusi & Display -->
                            <ColumnDefinition Width="*" />
                            <!-- Spacing Gap -->
                            <ColumnDefinition Width="14" />
                            <!-- Kolom Kanan: Profil & Opsi Proteksi -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ============================================== -->
                        <!-- KOLOM KIRI: TARGET RESOLUSI & DISPLAY          -->
                        <!-- ============================================== -->
                        <StackPanel Grid.Column="0">
                            <!-- CARD 1: TARGET RESOLUSI & DISPLAY -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="TARGET RESOLUSI &amp; DISPLAY"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <Button Style="{DynamicResource MiniPresetButton}"
                                                    Command="{Binding ShowGpuScalingGuideCommand}"
                                                    Width="20"
                                                    Height="20"
                                                    Padding="0"
                                                    Margin="6,0,0,0"
                                                    Cursor="Hand"
                                                    ToolTip="Agar layar stretched tanpa black bar: Pastikan scaling GPU diatur ke 'Full-screen'. Klik untuk panduan lengkap.">
                                                <TextBlock Text="?" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Quick GPU Control Panel Shortcuts -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource MiniPresetButton}"
                                                    Command="{Binding OpenGpuControlPanelCommand}"
                                                    Padding="8,2"
                                                    Height="22"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Buka NVIDIA Control Panel / Radeon Software untuk atur Full Panel Scaling">
                                                <TextBlock Text="⚙ GPU Panel" FontSize="10" />
                                            </Button>
                                            <Button Style="{DynamicResource MiniPresetButton}"
                                                    Command="{Binding OpenWindowsDisplaySettingsCommand}"
                                                    Padding="8,2"
                                                    Height="22"
                                                    ToolTip="Buka Pengaturan Tampilan Windows">
                                                <TextBlock Text="🖥 Windows" FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Target Monitor Selector -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Target Monitor:"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <ComboBox Grid.Column="1"
                                                  Style="{DynamicResource ModernComboBox}"
                                                  ItemsSource="{Binding Monitors}"
                                                  SelectedItem="{Binding SelectedMonitor}"
                                                  MinHeight="34"
                                                  FontSize="11.5">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Mode Resolusi: Preset vs Custom Input Toggle -->
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Content="Preset Stretched"
                                                         IsChecked="{Binding IsCustomResolution, Converter={StaticResource InverseBooleanConverter}}"
                                                         GroupName="ResMode"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         FontSize="11.5"
                                                         FontWeight="SemiBold"
                                                         Cursor="Hand"
                                                         Margin="0,0,18,0" />
                                            <RadioButton Content="Custom Resolution"
                                                         IsChecked="{Binding IsCustomResolution}"
                                                         GroupName="ResMode"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         FontSize="11.5"
                                                         FontWeight="SemiBold"
                                                         Cursor="Hand" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 1A: Segmented Ratio Bar & Preset Pills (Mode Preset) -->
                                    <StackPanel Visibility="{Binding IsCustomResolution, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <!-- Ratio Filter Segments -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Style="{StaticResource RatioChip43Style}"
                                                    Command="{Binding SelectRatioFilterCommand}"
                                                    CommandParameter="4:3"
                                                    Content="4:3 Stretched" />
                                            <Button Style="{StaticResource RatioChip169Style}"
                                                    Command="{Binding SelectRatioFilterCommand}"
                                                    CommandParameter="16:9"
                                                    Content="16:9 Native" />
                                            <Button Style="{StaticResource RatioChip1610Style}"
                                                    Command="{Binding SelectRatioFilterCommand}"
                                                    CommandParameter="16:10"
                                                    Content="16:10 Wide" />
                                            <Button Style="{StaticResource RatioChip54Style}"
                                                    Command="{Binding SelectRatioFilterCommand}"
                                                    CommandParameter="5:4"
                                                    Content="5:4 Ultra" />
                                            <Button Style="{StaticResource RatioChipSemuaStyle}"
                                                    Command="{Binding SelectRatioFilterCommand}"
                                                    CommandParameter="Semua"
                                                    Content="Semua" />
                                        </StackPanel>

                                        <!-- Resolution Pills Grid -->
                                        <ItemsControl ItemsSource="{Binding FilteredPresets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ResolutionPillStyle}"
                                                            Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Active Checkmark Indicator -->
                                                            <TextBlock Text="✓" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="10" 
                                                                       Foreground="{DynamicResource ValoRedBrush}" 
                                                                       Margin="0,0,6,0"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Resolution Text -->
                                                            <TextBlock Text="{Binding ResolutionText}" 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="11.5" 
                                                                       VerticalAlignment="Center" />

                                                            <!-- Aspect Ratio Chip (Monochrome) -->
                                                            <Border Background="{DynamicResource BgCardHoverBrush}"
                                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4" 
                                                                    Padding="5,1" 
                                                                    Margin="6,0,0,0" 
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AspectRatio}" 
                                                                           FontSize="9.5" 
                                                                           FontWeight="SemiBold" 
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>

                                                            <!-- Native Badge if IsNative -->
                                                            <Border Background="{DynamicResource AccentSubtleBrush}"
                                                                    CornerRadius="4" 
                                                                    Padding="5,1" 
                                                                    Margin="4,0,0,0" 
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsNative}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="NATIVE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource ValoRedBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Selected Resolution Summary Strip -->
                                        <Border Background="{DynamicResource BgDarkBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,8"
                                                Margin="0,4,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Target Aktif: " FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedPreset.DisplayName}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding SelectedPreset.Category}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ValoRedBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- 1B: Custom Resolution Input Manual (Ketika Mode Custom) -->
                                    <Border Background="{DynamicResource BgDarkBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="0,2,0,0"
                                            Visibility="{Binding IsCustomResolution, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Width (Lebar)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                                <TextBox Style="{DynamicResource ModernTextBox}"
                                                         Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="34"
                                                         FontSize="12"
                                                         FontWeight="Bold" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="×" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="12,18,12,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Height (Tinggi)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                                <TextBox Style="{DynamicResource ModernTextBox}"
                                                         Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="34"
                                                         FontSize="12"
                                                         FontWeight="Bold" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Refresh Rate Lock -->
                                    <Grid Margin="0,12,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Refresh Rate (Hz Lock):"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <ComboBox Grid.Column="1"
                                                  Style="{DynamicResource ModernComboBox}"
                                                  ItemsSource="{Binding RefreshRateOptions}"
                                                  SelectedItem="{Binding SelectedRefreshRate}"
                                                  MinHeight="34"
                                                  FontSize="11.5">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,1">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- KOLOM KANAN: PROFIL & OPSI PROTEKSI            -->
                        <!-- ============================================== -->
                        <StackPanel Grid.Column="2">
                            <!-- CARD 2: PROFIL PENGGUNA VALORANT -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="PROFIL PENGGUNA VALORANT"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <!-- Tombol Icon Buka Config -->
                                        <Button Style="{DynamicResource SecondaryButton}"
                                                Command="{Binding OpenConfigFolderCommand}"
                                                HorizontalAlignment="Right"
                                                Height="26"
                                                Padding="10,0"
                                                ToolTip="Buka direktori config Valorant di Windows Explorer">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📁" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="Folder Config" FontSize="10.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Dropdown Pemilih Profil Interaktif -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  Style="{DynamicResource ModernComboBox}"
                                                  ItemsSource="{Binding Profiles}"
                                                  SelectedItem="{Binding SelectedProfile}"
                                                  IsEnabled="{Binding ApplyToAllProfiles, Converter={StaticResource InverseBooleanConverter}}"
                                                  ToolTip="{Binding SelectedProfile.TooltipText}"
                                                  MinHeight="38">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,4" ToolTip="{Binding TooltipText}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AccountAlias}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding LastModified, StringFormat='Terakhir dimainkan: {0:dd/MM/yyyy HH:mm}'}" 
                                                                       FontSize="9.5" 
                                                                       Foreground="{DynamicResource TextMutedBrush}" 
                                                                       Margin="0,1,0,0" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" 
                                                                Background="{DynamicResource BgDarkBrush}" 
                                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4" 
                                                                Padding="8,3" 
                                                                Margin="8,0,0,0" 
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="RES: " FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding CurrentResX, StringFormat='{}{0}×'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                                                                    <TextBlock.Inlines>
                                                                        <Run Text="{Binding CurrentResY, Mode=OneWay}" />
                                                                    </TextBlock.Inlines>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Tombol Folder Spesifik Profil -->
                                        <Button Grid.Column="1"
                                                Style="{DynamicResource MiniPresetButton}"
                                                Command="{Binding OpenSelectedProfileFolderCommand}"
                                                Width="38"
                                                Height="38"
                                                Margin="8,0,0,0"
                                                ToolTip="Buka folder profil yang dipilih ini di Explorer">
                                            <TextBlock Text="📁" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>

                                    <!-- Switch Terapkan ke Semua Akun (Modern ToggleSwitch) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Terapkan ke Semua Akun" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Sinkronkan resolusi ke seluruh profil yang ditemukan" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{DynamicResource ModernToggleSwitch}"
                                                  IsChecked="{Binding ApplyToAllProfiles}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: OPSI & PROTEKSI CONFIG -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="OPSI &amp; PROTEKSI CONFIG"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,12" />

                                    <!-- Opsi 1: Kunci Config (Read-Only) -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Kunci Config (Read-Only)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Mencegah Valorant mereset resolusi otomatis saat login/restart" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{DynamicResource ModernToggleSwitch}"
                                                  IsChecked="{Binding IsReadOnlyChecked}"
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Separator tipis -->
                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}" Margin="0,0,0,12" Opacity="0.5" />

                                    <!-- Opsi 2: Backup Config Otomatis -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Backup Config Otomatis" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Membuat cadangan .ini (.bak) sebelum berkas ditimpa" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{DynamicResource ModernToggleSwitch}"
                                                  IsChecked="{Binding IsBackupChecked}"
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Separator tipis -->
                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}" Margin="0,0,0,12" Opacity="0.5" />

                                    <!-- Opsi 3: Ubah Resolusi Desktop (user32.dll) -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Ubah Resolusi Desktop (user32.dll)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Ubah resolusi Windows agar mode stretched aktif instan tanpa restart" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{DynamicResource ModernToggleSwitch}"
                                                  IsChecked="{Binding SyncDesktopResolution}"
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Separator tipis -->
                                    <Border Height="1" Background="{DynamicResource BorderDarkBrush}" Margin="0,0,0,12" Opacity="0.5" />

                                    <!-- Opsi 4: Auto-Revert Saat Game Ditutup -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Auto-Revert Saat Game Ditutup" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Watcher memantau proses VALORANT dan otomatis revert ke Native saat keluar" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{DynamicResource ModernToggleSwitch}"
                                                  IsChecked="{Binding IsAutoRevertOnGameExit}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ################################################# -->
                    <!-- TAB 1: MOUSE & AIM PRECISION                      -->
                    <!-- ################################################# -->
                    <Grid Visibility="{Binding IsMouseTab, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Aim Calculators & Compensation -->
                        <StackPanel Grid.Column="0">
                            <!-- CARD 1: eDPI Calculator -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="AIM &amp; EDPI CALCULATOR"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="#251216"
                                                    BorderBrush="{DynamicResource ValoRedBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,2"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CurrentEdpi, StringFormat='{}{0} eDPI'}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource ValoRedBrush}" />
                                            </Border>
                                            <Border Background="#0D1117"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,2">
                                                <TextBlock Text="{Binding EdpiCategory}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Inputs -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Mouse DPI -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Mouse DPI" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBox Style="{DynamicResource ModernTextBox}"
                                                     Text="{Binding MouseDpi, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,6" />
                                            <UniformGrid Columns="3">
                                                <Button Style="{DynamicResource MiniPresetButton}"
                                                        Command="{Binding SetDpiPresetCommand}"
                                                        CommandParameter="400" Content="400" Margin="0,0,2,0" />
                                                <Button Style="{DynamicResource MiniPresetButton}"
                                                        Command="{Binding SetDpiPresetCommand}"
                                                        CommandParameter="800" Content="800" Margin="2,0,2,0" />
                                                <Button Style="{DynamicResource MiniPresetButton}"
                                                        Command="{Binding SetDpiPresetCommand}"
                                                        CommandParameter="1600" Content="1600" Margin="2,0,0,0" />
                                            </UniformGrid>
                                        </StackPanel>

                                        <!-- In-Game Sens -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="In-Game Sensitivity" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBox Style="{DynamicResource ModernTextBox}"
                                                     Text="{Binding InGameSens, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,4" />
                                            <TextBlock Text="Nilai sens bidikan Valorant" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: Kalkulator Scoped Sensitivity (ADS & Sniper) -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="KALKULATOR SCOPED SENSITIVITY (ADS/SNIPER)"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Background="#162A45"
                                                BorderBrush="#38BDF8"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8,2"
                                                HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding EffectiveScopedEdpi, StringFormat='Scoped: {0} eDPI'}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#38BDF8" />
                                        </Border>
                                    </Grid>

                                    <!-- Scoped Multiplier Input & Zoom Breakdown -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Scoped Multiplier" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3" />
                                            <TextBox Style="{DynamicResource ModernTextBox}"
                                                     Text="{Binding ScopedSensMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30"
                                                     FontSize="12"
                                                     FontWeight="Bold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OperatorZoom1Edpi, StringFormat='Marshal/Op 2.5x: {0} eDPI'}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding OperatorZoom2Edpi, StringFormat='Operator 5.0x: {0} eDPI'}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Buttons to set recommended multiplier for stretched -->
                                    <TextBlock Text="Preset Scoped Sens Konsisten:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <UniformGrid Columns="3" Margin="0,0,0,4">
                                        <Button Style="{DynamicResource MiniPresetButton}"
                                                Command="{Binding ApplyScopedSensPresetCommand}"
                                                CommandParameter="43"
                                                Height="28"
                                                Margin="0,0,3,0"
                                                ToolTip="Rekomendasi 4:3 (0.750) agar fov/yaw terasa 1:1 saat scope sniper">
                                            <TextBlock Text="4:3 (0.750)" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Style="{DynamicResource MiniPresetButton}"
                                                Command="{Binding ApplyScopedSensPresetCommand}"
                                                CommandParameter="54"
                                                Height="28"
                                                Margin="2,0,2,0"
                                                ToolTip="Rekomendasi 5:4 (0.703) agar fov/yaw konsisten">
                                            <TextBlock Text="5:4 (0.703)" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Style="{DynamicResource MiniPresetButton}"
                                                Command="{Binding ApplyScopedSensPresetCommand}"
                                                CommandParameter="focal"
                                                Height="28"
                                                Margin="3,0,0,0"
                                                ToolTip="Focal Length / Monitor Distance 0% Match (0.847)">
                                            <TextBlock Text="Focal (0.847)" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                    </UniformGrid>

                                    <!-- Feedback Badge -->
                                    <Border Visibility="{Binding IsScopedSensApplied, Converter={StaticResource BoolToVisConverter}}"
                                            Background="#143224"
                                            BorderBrush="#10B981"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,3"
                                            Margin="0,4,0,0">
                                        <TextBlock Text="{Binding ScopedSensFeedbackText}"
                                                   Foreground="#10B981"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: Kompensasi Bidikan Stretched -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="KOMPENSASI BIDIKAN STRETCHED (1:1 YAW)"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <!-- Feedback Badge -->
                                        <Border Visibility="{Binding IsYawCompensationApplied, Converter={StaticResource BoolToVisConverter}}"
                                                Background="#143224"
                                                BorderBrush="#10B981"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding YawCompensationFeedbackText}"
                                                       Foreground="#10B981"
                                                       FontSize="10"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Real Action Button 4:3 Sens -->
                                        <Button Grid.Column="0"
                                                Style="{DynamicResource SecondaryButton}"
                                                Command="{Binding Apply43CompensationCommand}"
                                                Height="34"
                                                ToolTip="Klik untuk langsung perbarui In-Game Sens dengan kompensasi 4:3 (-25%)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎯 " FontSize="11" />
                                                <TextBlock Text="{Binding CompensatedSens43, StringFormat='Terapkan 4:3 ({0})'}" FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Real Action Button 5:4 Sens -->
                                        <Button Grid.Column="2"
                                                Style="{DynamicResource SecondaryButton}"
                                                Command="{Binding Apply54CompensationCommand}"
                                                Height="34"
                                                ToolTip="Klik untuk langsung perbarui In-Game Sens dengan kompensasi 5:4 (-30%)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎯 " FontSize="11" />
                                                <TextBlock Text="{Binding CompensatedSens54, StringFormat='Terapkan 5:4 ({0})'}" FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Pada resolusi stretched, target terasa bergerak lebih cepat secara horizontal. Tombol di atas langsung memperbarui sensitivitas agar reflek muscle memory 16:9 tetap presisi."
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: CROSSHAIR VAULT & PRO PRESETS -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="CROSSHAIR VAULT &amp; PRO PRESETS"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Background="#251216" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock Text="Pro &amp; Custom" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ValoRedBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Selector Label -->
                                    <TextBlock Text="Pilih Profil Crosshair:"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,5" />

                                    <!-- ComboBox -->
                                    <ComboBox Style="{DynamicResource ModernComboBox}"
                                              ItemsSource="{Binding CrosshairProfiles}"
                                              SelectedItem="{Binding SelectedCrosshair}"
                                              DisplayMemberPath="Name"
                                              MinHeight="32"
                                              FontSize="11"
                                              Margin="0,0,0,8" />

                                    <!-- Profile Detail Box -->
                                    <Border Background="#090D12"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <!-- Author & Tag -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="{Binding SelectedCrosshair.Author, StringFormat='Pemain / Author: {0}'}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           Foreground="#38BDF8"
                                                           VerticalAlignment="Center" />
                                                <Border Background="#161B22" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding SelectedCrosshair.Tag}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding SelectedCrosshair.Description}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,6" />

                                            <!-- Valorant Code Preview Box -->
                                            <Border Background="#12161F"
                                                    BorderBrush="#212631"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,5"
                                                    Margin="0,0,0,6">
                                                <TextBlock Text="{Binding SelectedCrosshair.Code}"
                                                           FontFamily="Consolas, Cascadia Code, monospace"
                                                           FontSize="9"
                                                           Foreground="#A0AEC0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SelectedCrosshair.Code}" />
                                            </Border>

                                            <!-- Action Buttons (Copy & Delete) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Copy Button -->
                                                <Button Grid.Column="0"
                                                        Style="{DynamicResource PrimaryButton}"
                                                        Command="{Binding CopyCrosshairCodeCommand}"
                                                        CommandParameter="{Binding SelectedCrosshair}"
                                                        Height="30"
                                                        ToolTip="Salin kode profil crosshair ke Clipboard">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📋 " FontSize="11" />
                                                        <TextBlock Text="Salin Kode Crosshair" FontWeight="Bold" FontSize="10.5" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Delete Button (Only for custom) -->
                                                <Button Grid.Column="2"
                                                        Style="{DynamicResource OutlineButton}"
                                                        Command="{Binding DeleteCrosshairCommand}"
                                                        CommandParameter="{Binding SelectedCrosshair}"
                                                        Height="30"
                                                        Padding="8,0"
                                                        ToolTip="Hapus profil crosshair custom ini"
                                                        Visibility="{Binding SelectedCrosshair.IsCustom, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="🗑 Hapus" FontSize="9.5" Foreground="#EF4444" FontWeight="SemiBold" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Feedback Banner -->
                                    <Border Visibility="{Binding IsCrosshairFeedbackVisible, Converter={StaticResource BoolToVisConverter}}"
                                            Background="#143224"
                                            BorderBrush="#10B981"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,0,8">
                                        <TextBlock Text="{Binding CrosshairFeedbackText}"
                                                   Foreground="#10B981"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <!-- Expander / Input Section for New Custom Crosshair -->
                                    <Expander Header="+ Tambah / Simpan Crosshair Baru"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              FontSize="10"
                                              FontWeight="SemiBold"
                                              Margin="0,2,0,0">
                                        <Border Background="#161B22"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10"
                                                Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Nama Profil:" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding NewCrosshairName, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{DynamicResource ModernTextBox}"
                                                         Height="28"
                                                         FontSize="10"
                                                         Margin="0,0,0,6" />

                                                <TextBlock Text="Pemain / Author (Opsional):" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding NewCrosshairAuthor, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{DynamicResource ModernTextBox}"
                                                         Height="28"
                                                         FontSize="10"
                                                         Margin="0,0,0,6" />

                                                <TextBlock Text="Kode Crosshair Valorant (0;s;1;P;...):" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding NewCrosshairCode, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{DynamicResource ModernTextBox}"
                                                         Height="28"
                                                         FontSize="10"
                                                         Margin="0,0,0,8" />

                                                <Button Style="{DynamicResource SecondaryButton}"
                                                        Command="{Binding SaveNewCrosshairCommand}"
                                                        Height="30"
                                                        ToolTip="Simpan profil crosshair ini ke crosshairs.json lokal">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="💾 " FontSize="10" />
                                                        <TextBlock Text="Simpan ke Vault" FontWeight="SemiBold" FontSize="10.5" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Windows Sensor Settings & Interactive Visualizer -->
                        <StackPanel Grid.Column="2">
                            <!-- CARD 4: Windows Raw Input & Config Sync -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="PENGATURAN SENSOR &amp; INPUT WINDOWS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,10" />

                                    <CheckBox Style="{DynamicResource ModernCheckBox}"
                                              IsChecked="{Binding DisableMouseAcceleration}"
                                              Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Disable Windows Mouse Acceleration (1:1 Raw Input)" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Menonaktifkan Enhance Pointer Precision Windows via SystemParametersInfo" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox Style="{DynamicResource ModernCheckBox}"
                                              IsChecked="{Binding SyncSensitivityToConfig}">
                                        <StackPanel>
                                            <TextBlock Text="Sinkronkan Sensitivitas ke Config Valorant saat Apply" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Menulis sens ke RiotUserSettings.ini secara otomatis" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- CARD 5: RAW ACCEL INTEGRATION & PROFILES -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Header: Title & Driver Status Badge -->
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="RAW ACCEL INTEGRATION &amp; PROFILES"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!-- Status Badge -->
                                        <Border Background="#0D1117"
                                                BorderBrush="{Binding RawAccelStatusColor}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,2"
                                                HorizontalAlignment="Right"
                                                ToolTip="{Binding RawAccelConfigDisplayPath}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding RawAccelStatusColor}" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding RawAccelStatusText}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding RawAccelStatusColor}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- STATE 1: TAMPILAN SAAT BELUM TERINSTAL (IsRawAccelInstalled == False) -->
                                    <StackPanel Visibility="{Binding IsRawAccelInstalled, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <!-- Informative Notice Container -->
                                        <Border Background="#161214"
                                                BorderBrush="#3D1D24"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="14,12"
                                                Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon Badge -->
                                                <Border Grid.Column="0"
                                                        Width="36"
                                                        Height="36"
                                                        CornerRadius="18"
                                                        Background="#291419"
                                                        BorderBrush="#7F1D1D"
                                                        BorderThickness="1"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="⤓"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#EF4444"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Notice Text -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Driver Raw Accel Belum Terdeteksi"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#FCA5A5"
                                                               Margin="0,0,0,4" />
                                                    <TextBlock Text="Driver Raw Accel belum terdeteksi di sistem Anda. Pasang driver Raw Accel terlebih dahulu untuk menggunakan kurva akselerasi custom dan fitur Auto-Sync Stretched Yaw 1:1."
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="15" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Action Buttons Row -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Tombol Aksi Utama: Download & Install Raw Accel -->
                                            <Button Grid.Column="0"
                                                    Style="{DynamicResource PrimaryButton}"
                                                    Command="{Binding OpenInstallRawAccelCommand}"
                                                    Height="34"
                                                    ToolTip="Buka link rilis resmi Raw Accel di browser default (https://github.com/a1xd/rawaccel/releases)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⤓" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Download &amp; Install Raw Accel" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Tombol Sekunder: Periksa Ulang Instalasi -->
                                            <Button Grid.Column="2"
                                                    Style="{DynamicResource OutlineButton}"
                                                    Command="{Binding RefreshRawAccelCommand}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    ToolTip="Pindai ulang sistem untuk mendeteksi driver atau file konfigurasi Raw Accel">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⟳" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Periksa Ulang Instalasi" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- STATE 2: TAMPILAN SAAT SUDAH TERINSTAL (IsRawAccelInstalled == True) -->
                                    <StackPanel Visibility="{Binding IsRawAccelInstalled, Converter={StaticResource BoolToVisConverter}}">
                                        <!-- Config Path Subtext -->
                                        <TextBlock Text="{Binding RawAccelConfigDisplayPath, StringFormat='Lokasi Config: {0}'}"
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8" />

                                        <!-- Curve Preset Selection -->
                                        <TextBlock Text="Preset Kurva Akselerasi Mouse:"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,0,0,5" />

                                        <!-- Quick Preset Buttons Grid -->
                                        <UniformGrid Columns="4" Margin="0,0,0,6">
                                            <Button Style="{DynamicResource MiniPresetButton}"
                                                    Command="{Binding SelectRawAccelPresetCommand}"
                                                    CommandParameter="Linear"
                                                    Height="28"
                                                    Margin="0,0,2,0"
                                                    ToolTip="Linear (Tracking): Akselerasi bertahap untuk tracking Apex / Overwatch">
                                                <TextBlock Text="Linear" FontSize="10" FontWeight="SemiBold" />
                                            </Button>
                                            <Button Style="{DynamicResource MiniPresetButton}"
                                                    Command="{Binding SelectRawAccelPresetCommand}"
                                                    CommandParameter="Natural"
                                                    Height="28"
                                                    Margin="2,0,2,0"
                                                    ToolTip="Natural (CS/Val): Offset mikro dan kurva natural untuk tactical shooter">
                                                <TextBlock Text="Natural" FontSize="10" FontWeight="SemiBold" />
                                            </Button>
                                            <Button Style="{DynamicResource MiniPresetButton}"
                                                    Command="{Binding SelectRawAccelPresetCommand}"
                                                    CommandParameter="Jump"
                                                    Height="28"
                                                    Margin="2,0,2,0"
                                                    ToolTip="Jump (Flick): Sens stabil saat bidik pelan, melonjak tajam saat flick">
                                                <TextBlock Text="Jump" FontSize="10" FontWeight="SemiBold" />
                                            </Button>
                                            <Button Style="{DynamicResource MiniPresetButton}"
                                                    Command="{Binding SelectRawAccelPresetCommand}"
                                                    CommandParameter="Off"
                                                    Height="28"
                                                    Margin="2,0,0,0"
                                                    ToolTip="Bypass/Off: 1:1 Raw mouse input tanpa kurva akselerasi">
                                                <TextBlock Text="Off / 1:1" FontSize="10" FontWeight="SemiBold" />
                                            </Button>
                                        </UniformGrid>

                                        <!-- ComboBox & Info -->
                                        <ComboBox Style="{DynamicResource ModernComboBox}"
                                                  ItemsSource="{Binding RawAccelPresets}"
                                                  SelectedItem="{Binding SelectedRawAccelPreset}"
                                                  DisplayMemberPath="Name"
                                                  MinHeight="32"
                                                  FontSize="11"
                                                  Margin="0,0,0,6" />

                                        <!-- Description preview box -->
                                        <Border Background="#090D12"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,0,0,10">
                                            <TextBlock Text="{Binding RawAccelPresetDescription}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <!-- Stretched Yaw Auto-Sync Option -->
                                        <CheckBox Style="{DynamicResource ModernCheckBox}"
                                                  IsChecked="{Binding AutoSyncRawAccelYaw}"
                                                  Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="Auto-sync Horizontal Yaw dengan Resolusi Stretched" FontWeight="SemiBold" FontSize="11" />
                                                <TextBlock Text="Otomatis mengatur Domain Weight X (misal 0.75 pada 4:3) di settings.json" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </CheckBox>

                                        <!-- Live Calculated Domain Weight Badge -->
                                        <Border Background="#161B22"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="{Binding RawAccelYawInfoText}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#38BDF8"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="Target: 1:1 Muscle Memory"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Action Buttons Bar -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Apply to Raw Accel -->
                                            <Button Grid.Column="0"
                                                    Style="{DynamicResource PrimaryButton}"
                                                    Command="{Binding ApplyRawAccelCommand}"
                                                    Height="32"
                                                    ToolTip="Simpan kurva dan domain weight terpilih langsung ke settings.json Raw Accel">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡" Margin="0,0,4,0" FontSize="11" />
                                                    <TextBlock Text="Apply to Raw Accel" FontWeight="Bold" FontSize="10.5" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Open Folder -->
                                            <Button Grid.Column="2"
                                                    Style="{DynamicResource OutlineButton}"
                                                    Command="{Binding OpenRawAccelFolderCommand}"
                                                    Height="32"
                                                    Padding="8,0"
                                                    ToolTip="Buka direktori instalasi / config Raw Accel di Windows Explorer">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📁" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBlock Text="Buka Folder" FontWeight="SemiBold" FontSize="10" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Refresh Status -->
                                            <Button Grid.Column="4"
                                                    Style="{DynamicResource MiniPresetButton}"
                                                    Command="{Binding RefreshRawAccelCommand}"
                                                    Width="32"
                                                    Height="32"
                                                    ToolTip="Periksa ulang status driver dan file settings.json">
                                                <TextBlock Text="⟳" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>

                                        <!-- Live Feedback Alert Banner -->
                                        <Border Visibility="{Binding IsRawAccelFeedbackVisible, Converter={StaticResource BoolToVisConverter}}"
                                                Background="#143224"
                                                BorderBrush="#10B981"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,6,0,0">
                                            <TextBlock Text="{Binding RawAccelFeedbackText}"
                                                       Foreground="#10B981"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CARD 6: Interactive Visualizer Rasio Layar 16:9 vs Stretched -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="VISUALIZER RASIO LAYAR (16:9 VS STRETCHED)"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,10" />

                                    <!-- Monitor Frame Visualizer -->
                                    <Border Background="#090D12"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Padding="10"
                                            Height="120"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <!-- 16:9 Native Frame (Dashed Blue) -->
                                            <Rectangle Stroke="#38BDF8" StrokeDashArray="4 2" StrokeThickness="1" Fill="#0D1E30" Opacity="0.4" />
                                            <TextBlock Text="16:9 Native Panel (100% Horizontal View)" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4,0,0" />

                                            <!-- 4:3 Stretched Hitbox Visual Model Representation -->
                                            <Border Background="#251216"
                                                    BorderBrush="{DynamicResource ValoRedBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="4"
                                                    Width="110"
                                                    Height="75"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Target Player" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                    <TextBlock Text="+33.3% Wider" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ValoRedBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Hitbox Illusion" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Center Aim Reticle -->
                                            <Ellipse Width="6" Height="6" Fill="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Comparison Stats Grid -->
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <Border Background="#0D1117" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="LEBAR MODEL TARGET" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="+33.3% Lebih Lebar" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ValoRedBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0D1117" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="3,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="HORIZONTAL YAW FEEL" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="+33.3% Lebih Cepat" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Background="#0D1117" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                        <TextBlock Text="💡 Tips Pro: Engine Valorant mengunci FOV vertikal pada 103°. Peregangan 4:3 membuat siluet musuh tampak lebih gemuk tanpa memotong sudut pandang."
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ################################################# -->
                    <!-- TAB 2: NETWORK & TWEAKS (2-COLUMN GRID)           -->
                    <!-- ################################################# -->
                    <Grid Visibility="{Binding IsNetworkTab, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Server Ping, System Tweaks & DNS -->
                        <StackPanel Grid.Column="0">
                            <!-- CARD 1: RIOT DIRECT PACKET LOSS & JITTER TESTER -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="RIOT DIRECT PACKET LOSS &amp; JITTER TESTER"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Style="{DynamicResource SecondaryButton}"
                                                Command="{Binding RefreshPingCommand}"
                                                HorizontalAlignment="Right"
                                                Height="24"
                                                Padding="8,0"
                                                FontSize="10"
                                                Content="Ping Cepat (⟳)" />
                                    </Grid>

                                    <!-- 3 Server Pods Grid -->
                                    <UniformGrid Columns="3" Margin="0,0,0,8">
                                        <!-- Singapore -->
                                        <Border Background="#0D1117" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="0,0,3,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="SINGAPORE (SG)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding ServerPingText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ServerPingColor}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                <TextBlock Text="AWS ap-southeast-1" FontSize="7.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Tokyo -->
                                        <Border Background="#0D1117" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="1.5,0,1.5,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="TOKYO (JP)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding TokyoPingText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding TokyoPingColor}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                <TextBlock Text="AWS ap-northeast-1" FontSize="7.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Hong Kong -->
                                        <Border Background="#0D1117" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="3,0,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="HONG KONG (HK)" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding HkPingText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding HkPingColor}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                <TextBlock Text="AWS ap-east-1" FontSize="7.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Deep Batch Quality Test Panel -->
                                    <Border Background="#090D12"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="HASIL DIAGNOSTIK JITTER &amp; PACKET LOSS (10 PROBES):" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                <Border Background="#161B22" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding SgQuality.QualityStatus, FallbackValue='Siap Diuji'}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding SgQuality.QualityColor, FallbackValue='#8B949E'}" />
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- SG Stats -->
                                                <Border Grid.Column="0" Background="#12161F" CornerRadius="4" Padding="6,4" Margin="0,0,2,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Singapore AP" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
                                                        <TextBlock Text="{Binding SgQuality.SummaryText, FallbackValue='Belum diuji'}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- Tokyo Stats -->
                                                <Border Grid.Column="1" Background="#12161F" CornerRadius="4" Padding="6,4" Margin="2,0,2,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Tokyo JP" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
                                                        <TextBlock Text="{Binding TokyoQuality.SummaryText, FallbackValue='Belum diuji'}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- HK Stats -->
                                                <Border Grid.Column="2" Background="#12161F" CornerRadius="4" Padding="6,4" Margin="2,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Hong Kong" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
                                                        <TextBlock Text="{Binding HkQuality.SummaryText, FallbackValue='Belum diuji'}" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Deep Test Action Button -->
                                    <Button Style="{DynamicResource PrimaryButton}"
                                            Command="{Binding RunDeepNetworkTestCommand}"
                                            Height="32"
                                            Margin="0,0,0,6"
                                            ToolTip="Kirim batch 10 paket beruntun untuk menghitung jitter rata-rata dan rasio packet loss">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ " FontSize="11" />
                                            <TextBlock Text="Mulai Uji Jaringan Lengkap (10 Paket)" FontWeight="Bold" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{Binding NetworkDiagnosticsStatusText}"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: Windows Anti-Stutter & Process Priority -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="OPTIMASI REGISTRY &amp; SISTEM GAME"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <!-- Game Status Badge -->
                                        <Border Background="#0D1117" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisConverter}}" />
                                                <TextBlock Text="{Binding GameStatusBadge}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <CheckBox Style="{DynamicResource ModernCheckBox}"
                                              IsChecked="{Binding DisableGameDvr}"
                                              Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Disable Windows Game Bar &amp; DVR (Anti-Stutter)" FontWeight="SemiBold" FontSize="11.5" />
                                            <TextBlock Text="Mematikan GameDVR di registry untuk mencegah frame drop" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox Style="{DynamicResource ModernCheckBox}"
                                              IsChecked="{Binding IsHighPriorityEnabled}"
                                              Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Set High Process Priority (Prioritas CPU)" FontWeight="SemiBold" FontSize="11.5" />
                                            <TextBlock Text="Prioritas proses VALORANT-Win64-Shipping.exe ke High" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox Style="{DynamicResource ModernCheckBox}"
                                              IsChecked="{Binding IsMinimizeToTrayEnabled}"
                                              Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Minimize Otomatis ke System Tray Saat Game Berjalan" FontWeight="SemiBold" FontSize="11.5" />
                                            <TextBlock Text="Hemat resource &amp; sembunyikan jendela RRes ke taskbar tray" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Discord Rich Presence Interactive Toggle Card -->
                                    <Border Background="#090D12"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <!-- Title + Status Badge -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="💬 " FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="Aktifkan Discord Rich Presence"
                                                               FontWeight="SemiBold"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />

                                                    <!-- Indikator Visual Ringkas [AKTIF] / [NONAKTIF] -->
                                                    <Border Background="{Binding DiscordRpcStatusBadgeBg}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DiscordRpcStatusBadgeText}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding DiscordRpcStatusBadgeColor}" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Subtitle / Keterangan -->
                                                <TextBlock Text="Tampilkan status resolusi stretched dan durasi bermain Valorant secara langsung di profil Discord."
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <!-- Toggle Switch Button -->
                                            <CheckBox Grid.Column="1"
                                                      Style="{DynamicResource ModernToggleSwitch}"
                                                      IsChecked="{Binding IsDiscordRpcEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Klik untuk menyalakan atau mematikan Discord Rich Presence" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: DNS Cache Cleaner -->
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="FLUSH DNS RESOLVER CACHE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="Bersihkan cache DNS Windows untuk segarkan rute ke server Riot."
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{DynamicResource SecondaryButton}"
                                            Command="{Binding FlushDnsCommand}"
                                            Height="30"
                                            Padding="10,0"
                                            Content="Flush DNS"
                                            FontSize="10.5"
                                            VerticalAlignment="Center" />
                                </Grid>
