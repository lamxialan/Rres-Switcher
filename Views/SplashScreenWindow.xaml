<Window x:Class="RRes.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Width="380"
        Height="440">

    <Grid x:Name="RootContainer"
          RenderTransformOrigin="0.5, 0.5"
          Opacity="0">

        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.92" ScaleY="0.92" />
        </Grid.RenderTransform>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Logo Image with Neon Glow Effect -->
            <Image x:Name="LogoImage"
                   Width="150"
                   Height="200"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center">
                <Image.Effect>
                    <DropShadowEffect Color="#FF4655"
                                      BlurRadius="28"
                                      ShadowDepth="0"
                                      Opacity="0.85" />
                </Image.Effect>
            </Image>

            <!-- Title & Subtitle Badge -->
            <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="RRES"
                           FontFamily="Segoe UI, Inter, Roboto"
                           FontWeight="Black"
                           FontSize="18"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF4655"
                                          BlurRadius="12"
                                          ShadowDepth="0"
                                          Opacity="0.8" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="VALORANT RESOLUTION SWITCHER"
                           FontFamily="Segoe UI, Inter, Roboto"
                           FontWeight="Bold"
                           FontSize="10"
                           Foreground="#8B949E"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
